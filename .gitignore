# ============================================================
# GeoAgent — .gitignore
# ============================================================

# ---------- Environment and secrets ----------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
service-account*.json
credentials*.json

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.venv/
venv/
env/
ENV/

# ---------- Node / Next.js (frontend) ----------
node_modules/
.pnp/
.pnp.js
.next/
out/
build/
next-env.d.ts
.eslintcache
.turbo/

# ---------- Data (see data/README.md) ----------
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/sample/*
!data/sample/.gitkeep

# ---------- Models / ML artifacts ----------
models/*
!models/README.md
*.pt
*.pth
*.onnx
*.h5
*.hdf5
*.joblib
*.pickle
mlruns/
lightning_logs/

# ---------- Notebooks ----------
.ipynb_checkpoints/
*.nbconvert.*

# ---------- Logs ----------
logs/
*.log

# ---------- Editors and OS ----------
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ---------- Misc temporary ----------
tmp/
temp/
*.tmp
.cache/