# ============================================================
# GeoAgent — environment template
#
# Copy this file to `.env` and fill in YOUR OWN values:
#   cp .env.example .env
#
# Rules:
#   - `.env` is ignored by git and must NEVER be committed.
#   - Use placeholder or empty values here only. Never put real
#     credentials in this file or in the repository.
#   - These variables are consumed by Docker Compose and passed to
#     the backend/frontend containers. For local development without
#     Docker, the backend reads `backend/.env` and the frontend uses
#     `frontend/.env.local` (see their .env.example files).
# ============================================================

# ------------------------------------------------------------------
# Application (Phase 2)
# ------------------------------------------------------------------
GEOAGENT_APP_ENV=development
GEOAGENT_APP_HOST=0.0.0.0
GEOAGENT_APP_PORT=8000

# ------------------------------------------------------------------
# Database — PostgreSQL/PostGIS (Phase 2)
# ------------------------------------------------------------------
GEOAGENT_DB_HOST=db
GEOAGENT_DB_PORT=5432
GEOAGENT_DB_NAME=geoagent
GEOAGENT_DB_USER=geoagent
GEOAGENT_DB_PASSWORD=
GEOAGENT_DB_SCHEMA=public
# Optional direct connection string (overrides the components above).
# GEOAGENT_DATABASE_URL=postgresql+psycopg://geoagent@localhost:5432/geoagent

# ------------------------------------------------------------------
# Authentication (Phase 2)
# ------------------------------------------------------------------
# REQUIRED for the backend to start outside the test environment.
# Generate one locally with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
GEOAGENT_AUTH_SECRET_KEY=
GEOAGENT_AUTH_ALGORITHM=HS256
GEOAGENT_ACCESS_TOKEN_EXPIRE_MINUTES=15
GEOAGENT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Google sign-in (optional; integration in a later phase). Configure only
# when real OAuth credentials are obtained. Never commit real values.
# GEOAGENT_GOOGLE_CLIENT_ID=
# GEOAGENT_GOOGLE_CLIENT_SECRET=

# ------------------------------------------------------------------
# Backend HTTP / CORS
# ------------------------------------------------------------------
# Comma-separated list of allowed browser origins for local development.
GEOAGENT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
GEOAGENT_BACKEND_PUBLIC_URL=http://localhost:8000

# ------------------------------------------------------------------
# Frontend (Phase 2)
# ------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
# When empty/unset, the Next.js dev server proxies /api/* to
# GEOAGENT_BACKEND_PUBLIC_URL so the browser uses same-origin requests.

# ------------------------------------------------------------------
# Frontend map tiles (Q1 Phase 3: location intelligence)
# ------------------------------------------------------------------
NEXT_PUBLIC_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors
NEXT_PUBLIC_MAP_TILE_MAX_ZOOM=19

# ------------------------------------------------------------------
# Satellite scene discovery + retrieval (Q1 Phase 4: satellite infrastructure)
# Providers are pluggable via env; discovery is key-less for the default
# provider (Microsoft Planetary Computer STAC/SAS). CDSE is optional and
# only used for downloads with real CDSE credentials never committed.
# ------------------------------------------------------------------
GEOAGENT_SATELLITE_ENABLED_PROVIDERS=planetary-computer
GEOAGENT_SATELLITE_MAX_SCENES_PER_PROVIDER=40
GEOAGENT_SATELLITE_MAX_CLOUD_COVER=100.0
GEOAGENT_SATELLITE_TIMEOUT_SECONDS=20.0
GEOAGENT_SATELLITE_RATE_PER_SECOND=0.0
GEOAGENT_SATELLITE_USER_AGENT=GeoAgent/0.1 (Phase 4 development)
GEOAGENT_PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
GEOAGENT_PLANETARY_COMPUTER_SAS_URL=https://planetarycomputer.microsoft.com/api/sas/v1
# Optional Copernicus Data Space Ecosystem (discovery + optional downloads).
GEOAGENT_CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1
GEOAGENT_CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
GEOAGENT_CDSE_CLIENT_ID=cdse-public
# GEOAGENT_CDSE_USERNAME=
# GEOAGENT_CDSE_PASSWORD=
# GEOAGENT_CDSE_TOTP=
# Bounded, on-demand asset retrieval.
GEOAGENT_RETRIEVAL_STORAGE_DIR=var/satellite
GEOAGENT_RETRIEVAL_MAX_BYTES=209715200
GEOAGENT_RETRIEVAL_MAX_ASSETS_PER_SCENE=8
GEOAGENT_RETRIEVAL_URL_ALLOWLIST=
GEOAGENT_RETRIEVAL_TIMEOUT_SECONDS=60.0

# ------------------------------------------------------------------
# Reserved — weather providers (Q2 Phase 8: weather infrastructure)
# ------------------------------------------------------------------
# GEOAGENT_WEATHER_PROVIDER=
# GEOAGENT_WEATHER_API_KEY=

# ------------------------------------------------------------------
# Geocoding / place search (Q1 Phase 3: location intelligence)
# Provider "photon" uses the open Photon geocoder (no API key required);
# "disabled" turns place search into a 503 service_unavailable.
# ------------------------------------------------------------------
GEOAGENT_GEOCODER_PROVIDER=photon
# GEOAGENT_GEOCODER_PHOTON_URL=https://photon.komoot.io/api
GEOAGENT_GEOCODER_TIMEOUT_SECONDS=15
GEOAGENT_GEOCODER_RATE_PER_SECOND=5
GEOAGENT_GEOCODER_USER_AGENT=geoagent/0.1 (https://github.com/kesavakantipudi/Geo-Agent)
GEOAGENT_GEOCODER_MAX_RESULTS=8

# ------------------------------------------------------------------
# Reserved — LLM configuration (Q3: agent framework / orchestrator)
# ------------------------------------------------------------------
# GEOAGENT_LLM_PROVIDER=
# GEOAGENT_LLM_API_KEY=
# GEOAGENT_LLM_MODEL=

# ------------------------------------------------------------------
# Reserved — storage (Q2/Q3 — object storage, uploads)
# ------------------------------------------------------------------
# GEOAGENT_STORAGE_BACKEND=local
# GEOAGENT_STORAGE_LOCAL_PATH=./storage

# ------------------------------------------------------------------
# Reserved — optional caching (later phases)
# ------------------------------------------------------------------
# GEOAGENT_REDIS_URL=redis://localhost:6379/0
# GEOAGENT_CACHE_ENABLED=false
