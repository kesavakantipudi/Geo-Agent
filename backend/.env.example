# ============================================================
# GeoAgent backend — environment template
#
# Copy this file to `.env` and fill in YOUR OWN values:
#   cp .env.example .env
#
# Run the backend from the backend/ directory so that pydantic-settings
# picks up this `.env` file. Never commit real values.
# ============================================================

# Application
GEOAGENT_APP_ENV=development
GEOAGENT_APP_HOST=0.0.0.0
GEOAGENT_APP_PORT=8000

# Database (PostgreSQL + PostGIS)
GEOAGENT_DB_HOST=localhost
GEOAGENT_DB_PORT=5432
GEOAGENT_DB_NAME=geoagent
GEOAGENT_DB_USER=geoagent
GEOAGENT_DB_PASSWORD=
GEOAGENT_DB_SCHEMA=public
# GEOAGENT_DATABASE_URL=postgresql+psycopg://geoagent:password@localhost:5432/geoagent

# Authentication — GEOAGENT_AUTH_SECRET_KEY is REQUIRED (>= 32 chars).
# Generate one locally with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
GEOAGENT_AUTH_SECRET_KEY=
GEOAGENT_AUTH_ALGORITHM=HS256
GEOAGENT_ACCESS_TOKEN_EXPIRE_MINUTES=15
GEOAGENT_REFRESH_TOKEN_EXPIRE_DAYS=30

# Google sign-in (optional; later phase). Only fill in with real OAuth credentials.
# GEOAGENT_GOOGLE_CLIENT_ID=
# GEOAGENT_GOOGLE_CLIENT_SECRET=

# CORS — comma-separated list of browser origins allowed in development.
GEOAGENT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Geocoding / place search (Phase 3 — Location Intelligence)
# Provider "photon" uses the open Photon geocoder (default); "disabled" turns
# place search into a 503 service_unavailable. Photon needs no API key.
GEOAGENT_GEOCODER_PROVIDER=photon
# GEOAGENT_GEOCODER_PHOTON_URL=https://photon.komoot.io/api
GEOAGENT_GEOCODER_TIMEOUT_SECONDS=15
GEOAGENT_GEOCODER_RATE_PER_SECOND=5
GEOAGENT_GEOCODER_USER_AGENT=geoagent/0.1 (https://github.com/kesavakantipudi/Geo-Agent)
GEOAGENT_GEOCODER_MAX_RESULTS=8

# Geometry processing (Phase 3)
# Maximum coordinate pairs accepted when parsing/importing geometries.
GEOAGENT_MAX_GEOMETRY_POINTS=2000
# How far into the future an analysis end date may reach (years).
GEOAGENT_ANALYSIS_MAX_FUTURE_YEARS=10

# ------------------------------------------------------------------
# Satellite scene discovery + retrieval (Q1 Phase 4) - see docs/architecture.md
# ------------------------------------------------------------------
# Providers are pluggable via env; default is Planetary Computer (STAC + SAS,
# no API key required for search; downloads use the short-lived SAS token it
# issues automatically). CDSE (Copernicus Data Space) is optional and only
# enables *downloads* when a username/password are provided.
# ------------------------------------------------------------------
# Providers enabled for scene discovery: comma-separated.
GEOAGENT_SATELLITE_ENABLED_PROVIDERS=planetary-computer
# Max scenes returned per provider per request (hard ceiling).
GEOAGENT_SATELLITE_MAX_SCENES_PER_PROVIDER=40
# Global default maximum cloud cover (percent) applied when the request
# does not specify a stricter value.
GEOAGENT_SATELLITE_MAX_CLOUD_COVER=100.0
# Per-request timeout and optional request throttling (0 = disabled).
GEOAGENT_SATELLITE_TIMEOUT_SECONDS=20.0
GEOAGENT_SATELLITE_RATE_PER_SECOND=0.0
GEOAGENT_SATELLITE_USER_AGENT=GeoAgent/0.1 (Q1 Phase 4 development)

# Microsoft Planetary Computer (default provider). STAC search is key-less;
# the SAS API mints short-lived download tokens per asset automatically.
GEOAGENT_PLANETARY_COMPUTER_STAC_URL=https://planetarycomputer.microsoft.com/api/stac/v1
GEOAGENT_PLANETARY_COMPUTER_SAS_URL=https://planetarycomputer.microsoft.com/api/sas/v1

# Copernicus Data Space Ecosystem (optional; discovery via its STAC API).
# Search works anonymously against the public STAC endpoint. Downloads are
# only attempted when GEOAGENT_CDSE_USERNAME/PASSWORD are set. NEVER commit
# real credentials; leave empty to skip CDSE downloads entirely.
GEOAGENT_CDSE_STAC_URL=https://stac.dataspace.copernicus.eu/v1
GEOAGENT_CDSE_TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
GEOAGENT_CDSE_CLIENT_ID=cdse-public
GEOAGENT_CDSE_USERNAME=
GEOAGENT_CDSE_PASSWORD=
GEOAGENT_CDSE_TOTP=

# Bounded, on-demand asset retrieval (Phase 4). Storage directory is relative
# to the backend working directory; downloads are size-capped per asset and
# restricted to a protocol+host allow-list (CDSE + Planetary Computer by
# default; extend with GEOAGENT_RETRIEVAL_URL_ALLOWLIST).
GEOAGENT_RETRIEVAL_STORAGE_DIR=var/satellite
GEOAGENT_RETRIEVAL_MAX_BYTES=209715200
GEOAGENT_RETRIEVAL_MAX_ASSETS_PER_SCENE=8
GEOAGENT_RETRIEVAL_URL_ALLOWLIST=
GEOAGENT_RETRIEVAL_TIMEOUT_SECONDS=60.0
